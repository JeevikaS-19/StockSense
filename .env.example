# Copy this file to .env and fill in what you need. Every value is optional for a local prototype.

# PostgreSQL connection string (Supabase, Neon, or self-hosted). Leave empty to use the embedded
# database in .data/pglite, which needs no setup.
DATABASE_URL=
# Set to true only for a database server with a self-signed certificate. Leave false for Neon and Supabase.
DATABASE_SSL_INSECURE=false

# Secret used to sign login tokens. Required when NODE_ENV=production. In development a random
# one is generated and saved in .data/jwt-secret.
JWT_SECRET=

# Port for the web server.
PORT=3000

# Public address of the app. Used in invitation and supplier links. Defaults to http://localhost:PORT.
APP_URL=

# Gemini API key for invoice reading, threshold reasons and drafted text. Without it, the app works
# and asks for manual entry instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Set to true to use canned AI results (for demos and tests). No key needed.
AI_MOCK=false

# Resend API key for emailing invitations, purchase orders to suppliers, and drafts. Without it, email
# is skipped and the links are shown in the app.
RESEND_API_KEY=
EMAIL_FROM="StockSense <onboarding@resend.dev>"

# Set to false to turn off the 15-minute automation job.
AUTOMATION_ENABLED=true

# Folder for the embedded database and generated secrets. Defaults to ./.data
STOCKSENSE_DATA_DIR=
